# chat/(DHO 챗봇) 컨테이너가 사용할 AI API 접속 정보. 이 파일을 .env로 복사한 뒤 실제 값을 채운다.
# chat은 2단계 LLM 구조 — 1단계(검색 계획)는 OPENAI_*, 2단계(실제 도구 호출 실행 + 최종
# 답변 정리)는 DEEPSEEK_*를 쓴다.
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5-mini
# build_embeddings.py(아이템 시맨틱 검색용 벡터 생성)와 chat의 시맨틱 검색이 함께 쓰는
# 임베딩 모델. 바꾸면 item_embeddings 테이블의 vector 차원도 같이 바꿔야 한다. DeepSeek은
# 임베딩 API가 없어 이 값은 계속 OpenAI를 쓴다.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# chat 2단계(실행+정리) 전담 — DeepSeek API(OpenAI 호환)
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-v4-flash

# PostgreSQL (구조화 데이터 서빙 DB, pgvector 포함) — webapp/chat이 공용으로 접속
POSTGRES_USER=dho
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dho

# Wiki.js — 같은 PostgreSQL 인스턴스 안 별도 DB(스키마 분리), 관리자 계정은
# 최초 기동 시 아래 값으로 자동 생성됨(설치 마법사 스킵)
WIKI_DB_NAME=wikidb
WIKI_ADMIN_EMAIL=admin@example.com
WIKI_ADMIN_PASS=change-me
# build_wikijs_pages.py(컨테이너 밖에서 실행 시 localhost 포트, 컨테이너 안에서는
# http://wikijs:3000)가 GraphQL API를 호출할 때 쓰는 주소
WIKIJS_URL=http://localhost:3001
# build_wiki_chunks.py가 wikidb.pages를 직접 읽을 때 쓰는 접속 문자열(위 WIKI_DB_NAME과
# 같은 DB를 가리켜야 함)
WIKI_DATABASE_URL=postgresql://dho:change-me@localhost:5434/wikidb
# dho_webapp.py의 /link/<name>이 브라우저를 리다이렉트할 때 쓰는 Wiki.js 주소. WIKIJS_URL과
# 달리 서버 프로세스가 아니라 사용자 브라우저가 접속해야 하므로 반드시 외부에서 접근 가능한
# 주소여야 함(NAS 배포 시 http://localhost:3001 그대로 두면 리다이렉트가 깨짐 — 실제
# NAS IP/도메인으로 바꿀 것)
WIKIJS_PUBLIC_URL=http://localhost:3001
