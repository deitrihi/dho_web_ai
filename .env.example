# chat/(DHO 챗봇) 컨테이너가 사용할 AI API 접속 정보. 이 파일을 .env로 복사한 뒤 실제 값을 채운다.
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5-mini
# build_embeddings.py(아이템 시맨틱 검색용 벡터 생성)와 chat의 시맨틱 검색이 함께 쓰는
# 임베딩 모델. 바꾸면 item_embeddings 테이블의 vector 차원도 같이 바꿔야 한다.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL (구조화 데이터 서빙 DB, pgvector 포함) — webapp/chat이 공용으로 접속
POSTGRES_USER=dho
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dho
