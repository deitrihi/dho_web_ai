# 이 파일을 .env.local로 복사한 뒤 실제 값을 채운다 (프로젝트 루트 .env.example과 같은 값 사용 가능)
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5-mini

# PostgreSQL 접속 문자열 (postgres 서비스를 로컬에 docker compose up -d postgres로 띄운 경우
# 기본값은 아래와 같음 — 프로젝트 루트 .env의 POSTGRES_USER/PASSWORD/DB 값과 맞춰야 함)
DATABASE_URL=postgresql://dho:change-me@localhost:5432/dho
